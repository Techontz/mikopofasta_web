# Copy to .env.local and fill in real values. .env.local is gitignored.

# 32+ char secret used to encrypt the mock BFF session cookie (lib/auth/session.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set once the real Laravel API exists (docs/backend-architecture-specification.md).
# Server-only — never NEXT_PUBLIC_, per docs/frontend-technical-specification.md §12.
LARAVEL_API_URL=
